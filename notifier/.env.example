# Copy to .env (never commit .env) to run locally with: npm start
# This file IS committed and public: never put real values here, only in .env
MODE=dry-run
TEST_EMAIL=you@example.com
# Path to the service account key you downloaded from Firebase (keep it OUTSIDE the repo folder)
FIREBASE_SERVICE_ACCOUNT=C:/Users/you/keys/champions-league-2026-firebase-adminsdk.json
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: pretend it's this time, to test a reminder window
# NOW=2026-11-23T18:00:00Z
